# NEXT Capital : copier en .env et compléter. Aucune clé n'est jamais écrite dans le code.

# Secret de signature des sessions (chaîne longue aléatoire)
SESSION_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Adresse publique du site, sans barre finale (retours Stripe, canonical, hreflang, sitemap, Open Graph).
# Seule source de l'URL publique : aucun domaine n'est écrit dans le code. Figée au build (variable NEXT_PUBLIC_).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexation par les moteurs de recherche. Tout autre valeur que "true" : tout le site est en noindex
# (balise robots + en-tête X-Robots-Tag) et robots.txt répond "Disallow: /".
# Rester à false tant que NEXT Capital n'est pas agréé (plateforme de démonstration d'un produit financier).
# Même à true, admin, compte, connexion, paiement et API restent noindex et bloqués dans robots.txt.
# Figée au build (variable NEXT_PUBLIC_) : reconstruire après modification.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Stripe (mode test). Vides = simulation locale du paiement par carte / Apple Pay.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Assistant (xAI Grok). Vide = assistant en mode orientation sans IA.
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Coordonnées bancaires affichées pour les virements SEPA (démonstration)
SEPA_IBAN=LU00 0000 0000 0000 0000
SEPA_BIC=XXXXLULL
SEPA_TITULAIRE=NEXT Capital S.A.

# Adresse de réception crypto affichée (démonstration)
CRYPTO_ADRESSE=0x0000000000000000000000000000000000000000
CRYPTO_RESEAU=Ethereum (USDC / USDT / ETH)
