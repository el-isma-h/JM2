# --- Base de données (obligatoire) ---
DATABASE_URL=postgresql://nextformation:nextformation@localhost:5432/nextformation

# --- Application ---
APP_URL=http://localhost:3000
# 32+ caractères aléatoires : signe les sessions et chiffre les secrets (RIB, TOTP). `openssl rand -base64 48`
APP_SECRET=change-me-change-me-change-me-change-me-change-me

# --- E-mail transactionnel (optionnel : sans clé, les e-mails sont journalisés dans la table outbox) ---
# Interrupteur général : rien ne part tant que MAIL_ENABLED n'est pas "true" (même avec une clé). Réglable dans Admin > Clés API.
# Laisser vide pour piloter depuis l'administration : une valeur non vide ici prime sur celle saisie dans l'admin.
MAIL_ENABLED=
RESEND_API_KEY=
MAIL_FROM="Next Formation <no-reply@example.com>"
# Vérification de l'adresse e-mail à l'inscription : "true" (toujours), "false" (jamais).
# Vide : exigée seulement si RESEND_API_KEY est renseignée. Sans vérification, le compte est marqué vérifié à sa création
# et le reste si la vérification est réactivée plus tard.
REQUIRE_EMAIL_VERIFICATION=

# --- Assistant et agents IA (optionnel : sans clé, l'assistant explique la configuration manquante) ---
# Recommandé en production : saisir la clé dans Admin > Clés API (chiffrée en base, appliquée sans redémarrage) et laisser vide ici.
# Une seule clé suffit. Ordre de priorité : Anthropic, OpenAI, xAI ; AI_PROVIDER=anthropic|openai|xai force un fournisseur.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
XAI_API_KEY=
XAI_MODEL=grok-3-mini
AI_PROVIDER=

# --- Stockage documentaire (optionnel : sans S3, les fichiers vont dans ./storage, privé) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
STORAGE_DIR=./storage

# --- Signature électronique (optionnel) ---
ESIGN_PROVIDER=
ESIGN_API_KEY=

# --- Compte administrateur plateforme créé au premier démarrage ---
ADMIN_EMAIL=admin@nextformation.local
ADMIN_PASSWORD=ChangeMoi!2026

# --- Tâches de fond : secret de l'en-tête x-cron-secret attendu par /api/cron (32+ caractères aléatoires) ---
CRON_SECRET=

# --- Mentions légales (affichées sur /mentions-legales, /cgu et /confidentialite) ---
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_FORM=
LEGAL_COMPANY_SIREN=
LEGAL_COMPANY_ADDRESS=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_CONTACT_EMAIL=
# Adresse pour l'exercice des droits RGPD (par défaut : LEGAL_CONTACT_EMAIL)
LEGAL_DPO_EMAIL=
# Nom, adresse et téléphone de l'hébergeur
LEGAL_HOST=

# En production, le serveur refuse de démarrer si la configuration est dangereuse (secrets d'exemple, e-mail absent…).
# SKIP_CONFIG_CHECK=1 désactive ce contrôle : à réserver à un test ponctuel.

# --- SEO : code de vérification Google Search Console (balise meta) ---
GOOGLE_SITE_VERIFICATION=

# --- Porte HPT (connexion unique et API de service depuis HPT Dashboard) : fermée tant que ces variables sont vides ---
# Secret partagé (base64, 32 octets), identique à NEXT_SSO_SECRET côté HPT. `openssl rand -base64 32`
HPT_SSO_SECRET=
# Clé de service propre à ce Next (32 caractères minimum), connue de HPT sous NEXT_CLE_SERVICE_FORMATION. `openssl rand -base64 48`
HPT_CLE_SERVICE=
# Adresse publique du dashboard HPT (lien « Retour à HPT »)
HPT_URL=

# --- Formation IA : connexion unique vers l'espace e-learning (optionnel : sans ces deux variables, le bouton
# « Ouvrir mon espace e-learning » explique la configuration manquante) ---
# Adresse publique de l'application e-learning (basePath /ia). Production : https://formation.nikaholding.world/ia ; local : http://localhost:3001/ia
IA_APP_URL=
# Secret HMAC partagé, 32 caractères minimum, identique à NF_SSO_SECRET côté e-learning. `openssl rand -base64 48`
IA_SSO_SECRET=
