# Next Formation IA — variables d'environnement (copier en .env). Ne jamais commiter .env.

# Base PostgreSQL 16. En local : bash scripts/dev-db.sh (port 5433). En Docker : fixé par docker-compose.yml.
DATABASE_URL=postgresql://nfia:nfia@localhost:5433/nfia
# Mot de passe de la base du docker-compose.yml
POSTGRES_PASSWORD=nfia

# Origine publique SANS /ia (liens d'invitation, QR code des certificats). https:// => cookie Secure.
APP_URL=http://localhost:3000
# Secret de chiffrement AES-256-GCM des clés API (≥ 32 caractères) : openssl rand -hex 32. Ne jamais le changer en production.
APP_SECRET=
# Forcer le flag Secure du cookie (true/false). Par défaut : déduit d'APP_URL.
COOKIE_SECURE=

# Compte administrateur créé par `npm run setup` s'il n'existe pas. ADMIN_RESET_PASSWORD=true pour réimposer le mot de passe.
ADMIN_EMAIL=admin@formation-ia.local
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=

# Compte démo (demo@formation-ia.local, connexion par bouton). false pour le désactiver.
DEMO_ENABLED=true

# Contenu de la formation (défaut : dossier parent de l'app ; /app/content dans l'image Docker).
CONTENT_DIR=

# Connexion unique depuis Next Formation (README § « Connexion unique depuis Next Formation »).
# NF_APP_URL : origine de Next Formation (liens « Mon dossier Next Formation », « Compléter mon inscription »).
#   Production : https://formation.nikaholding.world ; local : http://localhost:3100. Vide = liens masqués.
NF_APP_URL=
# NF_SSO_SECRET : secret partagé de signature des jetons (HMAC-SHA256), ≥ 32 caractères, IDENTIQUE à IA_SSO_SECRET
#   côté Next Formation : openssl rand -hex 32. Vide = route /ia/sso désactivée (page d'erreur).
NF_SSO_SECRET=

# Tuteur IA : une seule clé suffit (sinon réglage chiffré en base ou clé personnelle de l'apprenant).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
# Modèles du tuteur (facultatif ; défauts : claude-haiku-5-5, gpt-6-luna, grok-4.3).
ANTHROPIC_MODEL=
OPENAI_MODEL=
XAI_MODEL=
# Développement uniquement : réponses simulées sans appel réseau (ignoré en production).
AI_FAKE_PROVIDER=

# E-mails d'invitation via Resend (sinon le lien d'activation est affiché à copier).
RESEND_API_KEY=
MAIL_FROM=
