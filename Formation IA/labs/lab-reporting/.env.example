# Lab L058 — copiez en .env pour la variante Python. Ne commitez JAMAIS .env.
# Sans clé, le script fonctionne en mode simulé (FauxRedacteur, aucun appel réseau).

# Clé Anthropic : vide = mode simulé
ANTHROPIC_API_KEY=
# simulation | reel  (vide : réel si une clé est présente, simulé sinon)
LAB_MODE=
# Modèle de rédaction en mode réel (aucun paramètre temperature : erreur 400 avec l'API 2026-10-21)
REPORTING_MODELE=claude-haiku-5-5
# Date de référence (lundi d'exécution) ; vide = aujourd'hui
DATE_REF=2026-06-29
# Envoi facultatif (sinon affichage seul)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Direction (rapport contrôlé) et responsable (relecture si le contrôle échoue ou si la source est vide)
RAPPORT_TO=
RESPONSABLE_TO=
