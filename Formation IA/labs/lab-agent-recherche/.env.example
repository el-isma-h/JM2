# Lab L100 — copiez en .env et complétez. Ne commitez JAMAIS le fichier .env.
# Sans clé (ou LAB_MODE=simulation) : faux Claude + faux moteurs, aucun appel réseau, coûts simulés.
ANTHROPIC_API_KEY=
# Au moins un des deux moteurs en mode réel
PERPLEXITY_API_KEY=
XAI_API_KEY=
# simulation | reel
LAB_MODE=
# Dossier des livrables (note.md, dossier.json, journal.json)
VEILLE_SORTIE=livrables
# Attente de base entre deux essais (secondes, doublée à chaque essai)
VEILLE_ATTENTE_BASE=1
