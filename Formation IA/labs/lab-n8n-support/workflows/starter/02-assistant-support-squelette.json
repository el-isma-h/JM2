{
  "name": "Support — Assistant IA (squelette)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-entrant",
        "authentication": "headerAuth",
        "responseMode": "responseNode"
      },
      "name": "Webhook formulaire",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ticket_id\": $json.ticket_id } }}"
      },
      "name": "Répondre au site",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        460,
        480
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "ticket_id",
              "type": "string",
              "value": "={{ 'T-' + $now.toFormat('yyyyMMdd') + '-' + $execution.id.slice(-4) }}"
            },
            {
              "name": "email",
              "type": "string",
              "value": "={{ $json.body.email.toLowerCase().trim() }}"
            },
            {
              "name": "nom",
              "type": "string",
              "value": "={{ $json.body.nom }}"
            },
            {
              "name": "sujet",
              "type": "string",
              "value": "={{ $json.body.sujet }}"
            },
            {
              "name": "message",
              "type": "string",
              "value": "={{ $json.body.message }}"
            },
            {
              "name": "recu_le",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "name": "SW — Normaliser demande",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        230,
        300
      ]
    },
    {
      "parameters": {
        "inputText": "=Sujet : {{ $json.sujet }}\nMessage : {{ $json.message }}",
        "categories": {
          "categories": [
            {
              "category": "facturation",
              "description": "facture, paiement, avoir, TVA, doublon de prélèvement"
            },
            {
              "category": "technique",
              "description": "installation, appairage, application mobile, panne, mise à jour"
            },
            {
              "category": "livraison",
              "description": "délai, suivi de colis, adresse, colis endommagé"
            },
            {
              "category": "reclamation",
              "description": "remboursement, litige, menace d'avis négatif, ton agressif"
            },
            {
              "category": "autre",
              "description": "partenariat, presse, candidature, hors sujet"
            }
          ]
        }
      },
      "name": "Text Classifier",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "model": "claude-haiku-5-5",
        "options": {
          "maxTokensToSample": 256
        }
      },
      "name": "Claude Haiku 5.5 (tri)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        460,
        520
      ],
      "credentials": {
        "anthropicApi": {
          "name": "Anthropic — support"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Demande du client {{ $('SW — Normaliser demande').item.json.nom }} :\n{{ $('SW — Normaliser demande').item.json.message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "À COMPLÉTER : System Message de la section 3.3",
          "maxIterations": 6
        }
      },
      "name": "AI Agent rédaction",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        760,
        200
      ]
    },
    {
      "parameters": {
        "model": "claude-sonnet-5-5",
        "options": {
          "maxTokensToSample": 600
        }
      },
      "name": "Claude Sonnet 5.5 (rédaction)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        700,
        440
      ],
      "credentials": {
        "anthropicApi": {
          "name": "Anthropic — support"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "base_support",
        "toolDescription": "Recherche dans les fiches de support Maison Connectée (produits, livraison, retours, facturation).",
        "qdrantCollection": {
          "__rl": true,
          "mode": "list",
          "value": "support_fiches"
        },
        "topK": 5
      },
      "name": "Qdrant base_support",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.1,
      "position": [
        860,
        440
      ],
      "credentials": {
        "qdrantApi": {
          "name": "Qdrant local"
        }
      }
    },
    {
      "parameters": {
        "model": "nomic-embed-text"
      },
      "name": "Embeddings Ollama",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [
        860,
        600
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\"reponse\":\"…\",\"sources\":[\"…\"],\"confiance\":\"haute\",\"info_manquante\":\"\"}"
      },
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1020,
        440
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#support-validation"
        },
        "message": "À COMPLÉTER : message de la section 3.4",
        "options": {
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 4,
              "resumeUnit": "hours"
            }
          }
        }
      },
      "name": "Validation Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "slackApi": {
          "name": "Slack support"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "name": "Approuvé ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1380,
        200
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('SW — Normaliser demande').item.json.email }}",
        "subject": "=Re: {{ $('SW — Normaliser demande').item.json.sujet }} — ticket {{ $('SW — Normaliser demande').item.json.ticket_id }}",
        "message": "=Bonjour {{ $('SW — Normaliser demande').item.json.nom }},\n\n{{ $('AI Agent rédaction').item.json.output.reponse }}\n\nBien cordialement,\nL'équipe support Maison Connectée"
      },
      "name": "Gmail — envoyer réponse",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1640,
        120
      ],
      "credentials": {
        "gmailOAuth2": {
          "name": "Gmail support@"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#support-escalade"
        },
        "text": "=:warning: Ticket {{ $('SW — Normaliser demande').item.json.ticket_id }} à traiter manuellement ({{ $('SW — Normaliser demande').item.json.email }})."
      },
      "name": "Escalade humaine",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1120,
        560
      ],
      "credentials": {
        "slackApi": {
          "name": "Slack support"
        }
      }
    }
  ],
  "connections": {
    "Webhook formulaire": {
      "main": [
        [
          {
            "node": "SW — Normaliser demande",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SW — Normaliser demande": {
      "main": [
        [
          {
            "node": "Répondre au site",
            "type": "main",
            "index": 0
          },
          {
            "node": "Text Classifier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Text Classifier": {
      "main": [
        [
          {
            "node": "AI Agent rédaction",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "AI Agent rédaction",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "AI Agent rédaction",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Escalade humaine",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Escalade humaine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude Haiku 5.5 (tri)": {
      "ai_languageModel": [
        [
          {
            "node": "Text Classifier",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Claude Sonnet 5.5 (rédaction)": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent rédaction",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Qdrant base_support": {
      "ai_tool": [
        [
          {
            "node": "AI Agent rédaction",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Embeddings Ollama": {
      "ai_embedding": [
        [
          {
            "node": "Qdrant base_support",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    },
    "Structured Output Parser": {
      "ai_outputParser": [
        [
          {
            "node": "AI Agent rédaction",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent rédaction": {
      "main": [
        [
          {
            "node": "Validation Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validation Slack": {
      "main": [
        [
          {
            "node": "Approuvé ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approuvé ?": {
      "main": [
        [
          {
            "node": "Gmail — envoyer réponse",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Escalade humaine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Paris"
  }
}
