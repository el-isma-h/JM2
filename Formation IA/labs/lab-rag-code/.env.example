# Lab L094 — copiez en .env (docker compose le lit automatiquement). Ne commitez JAMAIS .env.
# Mot de passe de la base Postgres/pgvector (obligatoire pour docker compose)
PG_PASSWORD=changez-moi-mot-de-passe-long
# Clé Anthropic : vide = mode simulé (faux client à citations, aucun appel réseau)
ANTHROPIC_API_KEY=
# simulation | reel  (vide : réel si une clé est présente)
LAB_MODE=
RAG_MODEL=claude-sonnet-5-5
# starter | solution : quel dossier est construit dans l'image
RAG_APP_DIR=starter
# hash (hors ligne) | sentence-transformers (ajoutez le paquet à l'image, puis recalibrez RAG_SEUIL)
RAG_EMBEDDINGS=hash
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# Couverture minimale de la question par un extrait pour appeler le modèle (0 à 1)
RAG_SEUIL=0.5
