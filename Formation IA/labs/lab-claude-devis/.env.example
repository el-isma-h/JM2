# Lab L077 — copiez ce fichier en .env et complétez. Ne commitez JAMAIS le fichier .env.
# Sans clé, le lab fonctionne en mode simulé (aucun appel réseau).

# Clé API Anthropic (Console Claude Platform) — laisser vide pour le mode simulé
ANTHROPIC_API_KEY=
# simulation | reel  (vide : réel si une clé est présente, simulé sinon)
LAB_MODE=
# Modèle utilisé en mode réel
LAB_MODELE=claude-sonnet-5-5
# Identifiant du catalogue PDF téléversé une fois via la Files API (facultatif)
CATALOGUE_FILE_ID=
# Fichiers produits (journal des coûts, devis validés par l'artisan)
DEVIS_JOURNAL=journal.jsonl
DEVIS_VALIDES=devis_valides.jsonl
