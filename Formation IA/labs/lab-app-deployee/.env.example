# Lab L105 — copiez en .env (docker compose le lit). Ne commitez JAMAIS .env ni .env.production.
# Jeton de démonstration exigé par /api/chat (16 caractères minimum) : openssl rand -hex 24
DEMO_TOKEN=
# Clé Anthropic : vide = fournisseur simulé (aucun appel réseau, aucun coût). Jamais dans une variable NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
# simulation | reel  (vide : réel si une clé est présente, simulé sinon)
LAB_MODE=
AI_MODEL=claude-sonnet-5-5
# Bornes et coûts (exigences F1 et F4 de la leçon)
QUOTA_PAR_MINUTE=10
MAX_MESSAGES=30
MAX_CARACTERES=2000
MAX_OUTPUT_TOKENS=800
BUDGET_MENSUEL_USD=300
PROMPT_VERSION=dev
# Construction : starter | solution
APP_DIR=starter
# Déploiement : SHA du commit (renvoyé par /api/health) et domaine servi par Caddy
IMAGE_TAG=local
DOMAINE=localhost
